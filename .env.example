# Booking notifications — admin alerts sent to BOOKING_NOTIFICATION_EMAIL (defaults to info@)
BOOKING_NOTIFICATION_EMAIL=info@rideconnectuk.com
DISPATCH_EMAIL=info@rideconnectuk.com
EMAIL_FROM=RideConnect UK <info@rideconnectuk.com>

# 123 Reg SMTP (Professional Email — Generation 2)
# Recommended: keep SMTP configured even when using Resend — admin alerts fall back to SMTP
# if Resend cannot deliver to info@rideconnectuk.com (same-address loop).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@rideconnectuk.com
SMTP_PASS=your-123reg-mailbox-password

# Optional — Web3Forms access key from https://web3forms.com
# WEB3FORMS_ACCESS_KEY=xxxxxxxx

# Optional — Resend API key
# RESEND_API_KEY=re_xxxxxxxx

# Google Analytics 4 — measurement ID from analytics.google.com (Admin → Data streams)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console — HTML tag method (Search Console → property → Verify → HTML tag → copy content value)
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HOMEKENT_GOOGLE_SITE_VERIFICATION=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# KTH_GOOGLE_SITE_VERIFICATION=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz

# Kent Travel Hub GA4 — separate property recommended (falls back to NEXT_PUBLIC_GA_MEASUREMENT_ID)
# NEXT_PUBLIC_KTH_GA_MEASUREMENT_ID=G-YYYYYYYYYY

# Microsoft Clarity — project ID from clarity.microsoft.com → Settings → Overview
# NEXT_PUBLIC_KTH_CLARITY_PROJECT_ID=xxxxxxxxxx

# Google Maps — browser autocomplete + route map (set NEXT_PUBLIC_USE_GOOGLE_MAPS=true when billing is on)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# GOOGLE_MAPS_API_KEY=AIza...
# NEXT_PUBLIC_USE_GOOGLE_MAPS=true

# Airtable dispatch (optional — same base as AI phone bookings)
AIRTABLE_TOKEN=patxxxxxxxx
AIRTABLE_BASE_ID=appp3gYwPeng1JnRG
AIRTABLE_TABLE_NAME=Bookings
# Central dispatch booking API (all website forms proxy here)
DISPATCH_BOOKING_URL=https://dispatch.rideconnectuk.com/api/bookings/create
# Vercel Blob — required for booking email idempotency (one confirmation per booking)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# Optional — newsletter subscribers from Kent Travel Hub (create table with Email, Source, Subscribed At)
# AIRTABLE_SUBSCRIBERS_TABLE=Travel Subscribers

# RideConnect UK network domains (all on same Vercel project)
NEXT_PUBLIC_SITE_URL=https://dovertaxi.co.uk
# NEXT_PUBLIC_RIDECONNECT_URL=https://rideconnectuk.com
# NEXT_PUBLIC_ORION_URL=https://oriontaxis.co.uk
# NEXT_PUBLIC_GATWICK_URL=https://dovertogatwicktaxi.com
# NEXT_PUBLIC_PASSENGER_URL=https://dispatch.rideconnectuk.com/passenger

# HomeKent — cleaning site (homekent.co.uk on 123reg)
NEXT_PUBLIC_HOMEKENT_URL=https://homekent.co.uk
NEXT_PUBLIC_HOMEKENT_PHONE=01304 350521
NEXT_PUBLIC_HOMEKENT_EMAIL=info@homekent.co.uk

# Kent Travel Hub — travel info + RideConnect bookings (kenttravelhub.co.uk)
NEXT_PUBLIC_KTH_URL=https://kenttravelhub.co.uk
# NEXT_PUBLIC_KTH_BASE_PATH=/kenttravelhub
# Optional — National Highways closures API for live M20 incidents & Operation Brock
# Register at https://developer.data.nationalhighways.co.uk/
# NATIONAL_HIGHWAYS_API_KEY=
# NATIONAL_HIGHWAYS_API_URL=https://api.data.nationalhighways.co.uk
# GOOGLE_MAPS_API_KEY also powers live M20 journey times on Kent Travel Hub when set
# (Routes API + Directions; either GOOGLE_MAPS_API_KEY or NEXT_PUBLIC_GOOGLE_MAPS_API_KEY works)
# Optional TomTom routing fallback: https://developer.tomtom.com/
# TOMTOM_API_KEY=
# Optional Aerodatabox (RapidAPI) for London Stansted live flights: https://rapidapi.com/aerodatabox/api/aerodatabox
# AERODATABOX_RAPIDAPI_KEY=
# Optional National Rail live boards — consumer key from Rail Data Marketplace (free)
# 1. Register at https://raildata.org.uk/
# 2. Subscribe to "Live Departure Board" (LDBWS Public) — not "Fastest Departure Boards"
# 3. Copy the Consumer key from the product Specification tab into NATIONAL_RAIL_LDB_TOKEN
# NATIONAL_RAIL_LDB_TOKEN=
# Alias for the same consumer key:
# NATIONAL_RAIL_RDM_API_KEY=
# Optional Huxley2 proxy base URL (defaults to https://huxley2.azurewebsites.net)
# NATIONAL_RAIL_HUXLEY_URL=

# Kent Travel Hub Facebook — automated live travel posts (Vercel Cron)
# Page: https://www.facebook.com/profile.php?id=61591477063233
# 1. Create a Meta app at https://developers.facebook.com/
# 2. Add Facebook Login + request pages_manage_posts, pages_read_engagement
# 3. Generate a long-lived Page access token for Kent Travel Hub
# FACEBOOK_PAGE_ID=61591477063233
# FACEBOOK_PAGE_ACCESS_TOKEN=
# CRON_SECRET=generate-with-openssl-rand-hex-24

# Google AdSense — display ads on travel guides (https://adsense.google.com)
# NEXT_PUBLIC_KTH_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_KTH_ADSENSE_SLOT_ARTICLE_TOP=1234567890
# NEXT_PUBLIC_KTH_ADSENSE_SLOT_ARTICLE_MID=0987654321

# Booking.com affiliate — Partner Hub → create link → copy aid parameter
# NEXT_PUBLIC_KTH_BOOKING_AID=1234567
# HOMEKENT_QUOTE_EMAIL=info@homekent.co.uk
# HOMEKENT_EMAIL_FROM=HomeKent <info@homekent.co.uk>
# Required for HomeKent quote form — 123 Reg Professional Email mailbox (not RideConnect).
# HOMEKENT_SMTP_USER=info@homekent.co.uk
# HOMEKENT_SMTP_PASS=your-123reg-mailbox-password
# HOMEKENT_SMTP_HOST=smtpout.secureserver.net
# HOMEKENT_SMTP_PORT=465

# Square — card payments (https://developer.squareup.com/apps)
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_ENVIRONMENT=production

# Passenger app card payments via dovertaxi Square (shared secret with rideconnect-dispatch)
# DISPATCH_PAYMENT_SECRET=generate-with-openssl-rand-hex-24
# DISPATCH_PASSENGER_FULFILL_URL=https://dispatch.rideconnectuk.com/api/internal/fulfill-passenger-card
NEXT_PUBLIC_PHONES=01304350125,01304208208,01304350777
NEXT_PUBLIC_EMAIL=info@rideconnectuk.com
NEXT_PUBLIC_WHATSAPP=07405327650

# Soukromá evidence jízd (mimo dispatch) — /private/evidence
# PERSONAL_LEDGER_PASSWORD=your-secret-password
# PERSONAL_LEDGER_FILE=/absolute/path/personal-jobs.json

# RideConnect dispatch (separate app) — /platform and /driver redirect here
# NEXT_PUBLIC_DISPATCH_URL=https://rideconnect-dispatch.vercel.app/dashboard
# NEXT_PUBLIC_DRIVER_URL=https://rideconnect-dispatch.vercel.app/login

# Optional — only when YOUR app is published (not the legacy Cabcher listing)
# NEXT_PUBLIC_PASSENGER_URL=https://dispatch.rideconnectuk.com/passenger
# NEXT_PUBLIC_CUSTOMER_APP_STORE_URL=
# NEXT_PUBLIC_CUSTOMER_GOOGLE_PLAY_URL=
# NEXT_PUBLIC_DRIVER_APP_STORE_URL=
# NEXT_PUBLIC_DRIVER_GOOGLE_PLAY_URL=
