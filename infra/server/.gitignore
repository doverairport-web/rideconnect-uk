# RideConnect infra — never commit secrets or runtime state.
# Only configuration templates, scripts and docs belong in Git.

# Real environment files (templates like .env.example are allowed)
.env
.env.*
!.env.example

# Secrets directory (rclone.conf, offsite.env, ssh keys)
secrets/
rclone.conf
offsite.env

# Private keys / certs
*.pem
*.key
*_ed25519
*_ed25519.pub
*_rsa
*.p12
*.pfx
id_*

# Let's Encrypt material
nginx/letsencrypt/
nginx/certbot/

# Backups & database dumps
backups/
*.tar.gz
*.tgz
*.sql
*.sql.gz
*.dump
*.rdb
*.aof

# Runtime / generated
*.log
*.iotest
.DS_Store

# IP allowlists / host inventories (may reveal infra topology)
allowlist*.txt
hosts.ini
inventory.ini
